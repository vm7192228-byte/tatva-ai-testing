# Copy to .env for local development, then add real values locally.
# Keep secrets out of GitHub and frontend code.

# Required for Google Gemini chat
# GEMINI_API_KEY is intentionally not used in this learner-facing service; use an approved provider.
# Optional: use a current model ID from Google's Gemini model catalog
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Cloudflare Workers AI chat
# Create a Workers AI API token with the required Workers AI permissions.
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_WORKERS_AI_TOKEN
# Default: @cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Optional: Pollinations chat (server-side secret key, usually starts with sk_)
POLLINATIONS_API_KEY=YOUR_POLLINATIONS_SECRET_KEY
# Default: openai; see https://gen.pollinations.ai/v1/models for available models
# POLLINATIONS_MODEL=openai

# Primary Tatv Smart gateway: your private, multi-user CodeForge FreeLLM gateway.
# The gateway must trust this Workbench Supabase Auth issuer and enforce per-user quotas.
# Workbench forwards only the signed-in user's current Supabase access JWT.
CODEFORGE_GATEWAY_URL=https://YOUR_PRIMARY_PRIVATE_GATEWAY_HOST
# Paid image generation stays disabled until this is set to an exact, reviewed
# public image model ID enabled in every configured private gateway (never use auto).
# CODEFORGE_GATEWAY_IMAGE_MODEL=pollinations/<reviewed-image-model-id>
# Default pool used by all three public Tatv modes unless a mode-specific model is set.
CODEFORGE_GATEWAY_MODEL=auto
# Optional reviewed model IDs. Keep these as "auto" for full provider-family failover.
CODEFORGE_GATEWAY_FLASH_MODEL=auto
CODEFORGE_GATEWAY_SMART_MODEL=auto
CODEFORGE_GATEWAY_ULTRA_MODEL=auto

# Optional independent private gateway backups (up to three). Each backup must
# run independently, trust the same Workbench Supabase Auth issuer, and have its
# own healthy deployment, enabled model catalog and approved upstream credentials.
CODEFORGE_GATEWAY_FALLBACK_URL=https://YOUR_BACKUP_1_PRIVATE_GATEWAY_HOST
CODEFORGE_GATEWAY_FALLBACK_2_URL=https://YOUR_BACKUP_2_PRIVATE_GATEWAY_HOST
CODEFORGE_GATEWAY_FALLBACK_3_URL=https://YOUR_BACKUP_3_PRIVATE_GATEWAY_HOST
# Optional model override for backup 1; otherwise the selected Tatv mode is used.
# CODEFORGE_GATEWAY_FALLBACK_MODEL=auto
# Optional model overrides for backups 2 and 3.
# CODEFORGE_GATEWAY_FALLBACK_2_MODEL=auto
# CODEFORGE_GATEWAY_FALLBACK_3_MODEL=auto

# FreeLLMAPI first hop for all Tatv Smart requests (server-only).
# The unified key is never exposed to the browser or forwarded to a private gateway.
# Use this shared route only where the upstream account/terms authorize multi-user traffic.
# FREELLMAPI_BASE_URL=https://your-freellmapi-host/v1
# FREELLMAPI_API_KEY=YOUR_SERVER_SIDE_UNIFIED_KEY
# FREELLMAPI_MODEL=auto

# Optional: official, safety-aligned Qwen 3.8-27B on your own secured inference host.
# Use an OpenAI-compatible vLLM/SGLang endpoint with HTTPS; /v1 is appended when omitted.
# Keep these values server-side only. Protect the inference host behind an authenticated reverse proxy.
# Qwen model ID is fixed in the app to Qwen/Qwen3.8-27B; the abliterated/uncensored variant is not supported.
QWEN_BASE_URL=https://YOUR_SECURED_QWEN_INFERENCE_HOST
QWEN_API_KEY=YOUR_QWEN_REVERSE_PROXY_API_KEY
# Leave tools disabled unless the inference server is configured with Qwen's qwen3_coder tool parser.
QWEN_ENABLE_TOOLS=false

# Supabase Auth (optional for guest chat; needed for accounts/profile features)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Server-only key for database-backed quotas, durable chat and approval/video jobs.
# Never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# KIE Video Studio (server-side only; KIE_API_KEY is required).
KIE_API_KEY=YOUR_KIE_API_KEY
# Optional but recommended for signed task-recovery callbacks: use the separate webhookHmacKey from KIE AI Settings. Do not use KIE_API_KEY here.
KIE_WEBHOOK_HMAC_KEY=YOUR_KIE_WEBHOOK_HMAC_KEY
# Without this optional key, CodeForge uses the normal KIE status-polling flow.
# Optional; callback URLs otherwise use the HTTPS request origin.
# PUBLIC_APP_URL=https://your-codeforge-domain.example

# GitHub OAuth workspace (server-side only). Register:
# https://YOUR_PRODUCTION_DOMAIN/api/github/callback
GITHUB_CLIENT_ID=YOUR_GITHUB_OAUTH_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_OAUTH_CLIENT_SECRET
# Use a long random secret distinct from provider API keys.
GITHUB_TOKEN_SECRET=YOUR_RANDOM_ENCRYPTION_SECRET

# Optional: Tavily web search for current prices, news, weather, research and source links
# Create a key at https://tavily.com/ and add it only to server-side environment variables.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# Cashfree subscription checkout (sandbox by default)
CASHFREE_APP_ID=YOUR_CASHFREE_TEST_APP_ID
CASHFREE_SECRET_KEY=YOUR_CASHFREE_TEST_SECRET_KEY
# Keep this at sandbox while using TEST credentials.
CASHFREE_ENVIRONMENT=sandbox
